{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "types": ["cypress", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "support/**/*.ts"
  ]
}
