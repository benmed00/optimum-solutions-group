# Optimum Solutions Group - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# =============================================================================
# Analytics (Optional)
# =============================================================================
# Backend endpoint for analytics events. When set, analytics data is sent to
# this URL instead of console. Leave empty to disable API transmission.
# VITE_ANALYTICS_API_ENDPOINT=https://your-analytics-api.com/events

# API key for analytics endpoint authentication. Sent as Bearer token.
# VITE_ANALYTICS_API_KEY=your-api-key

# Analytics endpoint for Core Web Vitals dashboard (e.g., useCoreWebVitals hook).
# VITE_ANALYTICS_ENDPOINT=https://your-analytics-api.com/web-vitals
